# =============== BASE STAGE ===============
# Unlighthouse 0.18 + Lighthouse 13 require Node >= 22.19 (fs.promises.glob).
FROM node:22-alpine AS base

WORKDIR /app

RUN corepack enable \
    && corepack prepare pnpm@9.15.0 --activate

# Chromium is required by Unlighthouse/Puppeteer in development/build flows.
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    font-noto \
    && ln -sf /usr/bin/chromium /usr/bin/chromium-browser \
    && rm -rf /var/cache/apk/*

ENV PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser \
    CHROME_PATH=/usr/bin/chromium-browser \
    CHROMIUM_PATH=/usr/bin/chromium-browser

# Install workspace dependencies first to improve Docker cache reuse.
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./

RUN pnpm install --frozen-lockfile


# =============== DEVELOPMENT STAGE ===============
FROM base AS development

WORKDIR /app

RUN if [ ! -e /usr/bin/chromium-browser ] && [ -e /usr/bin/chromium ]; then \
      ln -sf /usr/bin/chromium /usr/bin/chromium-browser; \
    fi

COPY . .

# Keep this because workspace source/package manifests may have changed
# after the cached base dependency layer.
RUN pnpm install --frozen-lockfile

COPY docker/scripts/nx-dev-entrypoint.sh /usr/local/bin/nx-dev-entrypoint.sh

RUN chmod +x /usr/local/bin/nx-dev-entrypoint.sh

EXPOSE 7002

ENV PORT=7002 \
    UNLIGHTHOUSE_MODE=cli \
    UNLIGHTHOUSE_INLINE=true \
    UNLIGHTHOUSE_ALLOW_LOCAL=true

ENTRYPOINT ["/usr/local/bin/nx-dev-entrypoint.sh"]

CMD [ "pnpm", "nx", "serve", "ladipage-backend", "--host=0.0.0.0", "--skip-nx-cache"]

# =============== BUILD + DEPLOY-METADATA STAGE ===============
FROM base AS builder

WORKDIR /app

COPY . .

RUN pnpm nx build ladipage-backend \
  && pnpm nx build-worker ladipage-backend \
  && node tools/generate-deploy-lockfile.cjs \
       ladipage-backend dist/apps/ladipage-backend \
       tslib=2.8.1 \
       @unlighthouse/cli=0.18.0 \
       puppeteer=25.3.0


# =============== PRODUCTION DEPENDENCIES STAGE ===============
FROM node:22-alpine AS production-deps

WORKDIR /app/dist

RUN corepack enable \
    && corepack prepare pnpm@9.15.0 --activate

# Native build tools may be required by production dependencies.
RUN apk add --no-cache \
    python3 \
    make \
    g++

ENV NODE_ENV=production \
    PUPPETEER_SKIP_DOWNLOAD=true

# Copy generated deployment artifact.
#
# Expected content includes:
# - main.js
# - worker.main.js
# - package.json
# - pnpm-lock.yaml
# - generated runtime assets
COPY --from=builder /app/dist/apps/ladipage-backend ./

# DO NOT COPY:
#
# COPY --from=builder \
#   /app/dist/apps/ladipage-backend/node_modules \
#   ./node_modules
#
# Builder does not generate that directory.
# pnpm install below creates /app/dist/node_modules.

# A few production seed/compatibility stores intentionally read
# contract fixture JSON files at runtime.
COPY --from=builder \
    /app/apps/ladipage-backend/test/contract/fixtures \
    ./test/contract/fixtures

# Install the frozen production dependency set generated from
# the runtime package.json.
RUN pnpm install --prod --frozen-lockfile


# =============== SHARED PRODUCTION RUNTIME ===============
FROM node:22-alpine AS production-runtime

WORKDIR /app/dist

ENV NODE_ENV=production

RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    font-noto \
    && rm -rf /var/cache/apk/* \
    && if [ ! -e /usr/bin/chromium-browser ] && [ -e /usr/bin/chromium ]; then \
         ln -sf /usr/bin/chromium /usr/bin/chromium-browser; \
       fi

ENV PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser \
    CHROME_PATH=/usr/bin/chromium-browser \
    CHROMIUM_PATH=/usr/bin/chromium-browser \
    UNLIGHTHOUSE_BIN=/app/dist/node_modules/.bin/unlighthouse-ci

COPY --from=production-deps --chown=node:node /app/dist ./

# Winston DailyRotateFile writes to ./logs.
# The application runs as non-root user `node`, so prepare a writable log dir.
RUN mkdir -p /app/dist/logs \
    && chown -R node:node /app/dist/logs \
    && chmod 775 /app/dist/logs


# =============== PRODUCTION API TARGET ===============
FROM production-runtime AS production-api

EXPOSE 7002

HEALTHCHECK \
    --interval=30s \
    --timeout=5s \
    --start-period=90s \
    --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||process.env.LADIPAGE_PORT||7002)+'/api/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "main.js"]


# =============== PRODUCTION WORKER TARGET ===============
FROM production-runtime AS production-worker

# Worker has no HTTP port.
# Scan /proc because Docker Compose may use init/tini as PID 1.
HEALTHCHECK \
    --interval=30s \
    --timeout=5s \
    --start-period=90s \
    --retries=3 \
    CMD node -e "const f=require('fs');const ok=f.readdirSync('/proc').filter(x=>/^\\d+$/.test(x)).some(x=>{try{return f.readFileSync('/proc/'+x+'/cmdline','utf8').includes('worker.main')}catch{return false}});process.exit(ok?0:1)"

CMD ["node", "worker.main.js"]


# =============== BACKWARD-COMPATIBLE DEFAULT ===============
FROM production-api AS production