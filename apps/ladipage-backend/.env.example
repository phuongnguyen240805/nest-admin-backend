# LadiPage Backend — biến riêng app (nx serve)
# Biến shared libs (DB, JWT, Supabase, Stripe, LibreFang, …) → xem /.env ở root monorepo
# Khi dev: copy từ root .env hoặc dùng --env-file=../../.env

PORT=7002
APP_CODE=ladipage
APP_SCOPED_AUTH=false

# Feature flag CRM V2 (chỉ ladipage-backend)
CRM_ENABLED=false

# ================== AI SEO → OpenSEO ==================
OPENSEO_BASE_URL=http://localhost:7003
OPENSEO_MCP_URL=http://localhost:7003/mcp
AI_SEO_DATAFORSEO_DAILY_QUOTA=0
# prod: false | dev: true
OPENSEO_ALLOW_DEFAULT_FALLBACK=false

# ================== AI SEO → Umami (docker :7004) ==================
# UI: http://localhost:7004  |  default login admin / umami
# Self-host: no API keys menu — use username/password (Nest auto-login)
# prod: true
UMAMI_ENABLED=true
UMAMI_BASE_URL=http://localhost:7004
UMAMI_PUBLIC_SCRIPT_URL=http://localhost:7004
UMAMI_USERNAME=admin
UMAMI_PASSWORD=umami
UMAMI_API_KEY=
UMAMI_TIMEOUT_MS=3000
UMAMI_CIRCUIT_FAILURE_THRESHOLD=5
UMAMI_CIRCUIT_OPEN_MS=60000
UMAMI_CACHE_TTL_SECONDS=300
UMAMI_CACHE_STALE_TTL_SECONDS=3600

# BullMQ — prod API: RUN_WORKERS=false; worker process: true
BULLMQ_ENABLED=true
BULLMQ_PREFIX=liora:ladipage
REDIS_URL=redis://localhost:6381
BULLMQ_RUN_WORKERS=false

# ================== Unlighthouse (prod flags) ==================
# prod: MODE=cli INLINE=false ALLOW_LOCAL=false FALLBACK_MOCK=false AUTO_ON_PUBLISH=true
# dev:  MODE=mock INLINE=true  ALLOW_LOCAL=true
UNLIGHTHOUSE_MODE=cli
UNLIGHTHOUSE_INLINE=false
UNLIGHTHOUSE_AUTO_ON_PUBLISH=true
UNLIGHTHOUSE_ALLOW_LOCAL=false
UNLIGHTHOUSE_FALLBACK_MOCK=false
UNLIGHTHOUSE_BIN=unlighthouse-ci
UNLIGHTHOUSE_TIMEOUT_MS=300000
UNLIGHTHOUSE_COOLDOWN_MS=60000
# Reuse last successful lab result for normal opens/list actions (10 minutes).
UNLIGHTHOUSE_RESULT_CACHE_MS=600000
UNLIGHTHOUSE_PUBLISH_SKIP_IF_RECENT_MIN=15

LANDING_AI_JOBS_PER_USER=5
# prod: false
LANDING_AI_MOCK_GENERATE=false

# ================== Commerce / Medusa (hybrid) ==================
# MOCK=true  → products only in Nest memory (NOT visible in Medusa Admin)
# MOCK=false + MEDUSA_ADMIN_API_KEY → create/list goes to Medusa Admin API
# If MOCK unset and ADMIN key set → auto LIVE
#
# Live mode provisions per-org isolation on first store use (idempotent):
#   1 org → 1 Medusa Sales Channel + 1 publishable key scoped to it.
# The org↔channel link persists in table commerce_store_link (survives restart).
# Every Admin catalog query is scoped to the org's sales channel — no cross-tenant leak.
COMMERCE_MEDUSA_ENABLED=true
COMMERCE_MEDUSA_MOCK=true
COMMERCE_MEDUSA_MONETIZE=false
MEDUSA_BACKEND_URL=http://localhost:9000
# Secret API key from Medusa Admin (Settings → Secret API key) — NOT publishable
MEDUSA_ADMIN_API_KEY=
MEDUSA_PUBLISHABLE_KEY=
MEDUSA_DEFAULT_REGION_ID=reg_01_vn
MEDUSA_DEFAULT_CURRENCY=vnd
MEDUSA_TIMEOUT_MS=15000

SCREENSHOT_TO_CODE_HTTP_URL=http://localhost:7010
SCREENSHOT_TO_CODE_WS_URL=ws://localhost:7010
S2C_DEFAULT_STACK=html_css
S2C_GENERATE_TIMEOUT_MS=300000


# ========================================================= ads platforms (Google, TikTok, Facebook, …) configs =========================================================
# Core configuration:
ADS_VAULT_MASTER_KEY=<32-byte-base64-secret>
SHIPPING_VAULT_MASTER_KEY=<32-byte-base64-secret>
ADS_VAULT_KEY_VERSION=v1
ADS_OAUTH_RETURN_ORIGINS=https://app.example.com
ADS_EXTENSION_SESSION_TTL_SECONDS=600
BULLMQ_ENABLED=true
BULLMQ_RUN_WORKERS=true

# Meta:
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=vXX.X
META_REDIRECT_URI=https://api.example.com/api/ads-platform/connections/meta/oauth/callback
META_ADS_SCOPES=ads_management,ads_read,business_management,pages_read_engagement

# TikTok:
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_API_VERSION=vX.X
TIKTOK_API_BASE_URL=https://business-api.tiktok.com/open_api/vX.X
TIKTOK_AUTH_URL=https://business-api.tiktok.com/portal/auth
TIKTOK_REDIRECT_URI=https://api.example.com/api/ads-platform/connections/tiktok/oauth/callback

# Shopee:
SHOPEE_ADS_PARTNER_ENABLED=false
SHOPEE_ADS_PUBLISH_ENABLED=false
SHOPEE_ADS_ALLOWED_HOSTS=partner-api.example.com
SHOPEE_ADS_API_BASE_URL=https://partner-api.example.com/v1
SHOPEE_ADS_API_VERSION=v1
SHOPEE_ADS_AUTH_URL=https://partner-api.example.com/oauth/authorize
SHOPEE_ADS_TOKEN_PATH=/oauth/token
SHOPEE_ADS_CLIENT_ID=
SHOPEE_ADS_CLIENT_SECRET=
SHOPEE_ADS_REDIRECT_URI=https://api.example.com/api/ads-platform/connections/shopee/oauth/callback
SHOPEE_ADS_EXTERNAL_USER_ID_FIELD=shop_id
SHOPEE_ADS_ACCOUNTS_PATH=/ads/accounts
SHOPEE_ADS_CAMPAIGNS_PATH=/ads/campaigns
SHOPEE_ADS_PERFORMANCE_PATH=/ads/performance
SHOPEE_ADS_CAMPAIGN_CREATE_PATH=/ads/campaigns
SHOPEE_ADS_CAMPAIGN_GET_PATH=/ads/campaigns/{campaignId}
SHOPEE_ADS_CAMPAIGN_ID_FIELD=campaign_id
SHOPEE_ADS_PAUSED_STATUS=PAUSED
